{
  "name": "shiye",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "shiye",
      "version": "0.0.0",
      "workspaces": [
        "apps/*",
        "packages/*",
        "packages/adapters/*"
      ]
    },
    "apps/extension": {
      "name": "@shiye/extension",
      "version": "0.0.0"
    },
    "apps/workspace": {
      "name": "@shiye/workspace",
      "version": "0.0.0"
    },
    "node_modules/@shiye/ai-adapter": {
      "resolved": "packages/adapters/ai",
      "link": true
    },
    "node_modules/@shiye/application": {
      "resolved": "packages/application",
      "link": true
    },
    "node_modules/@shiye/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@shiye/extension": {
      "resolved": "apps/extension",
      "link": true
    },
    "node_modules/@shiye/storage": {
      "resolved": "packages/storage",
      "link": true
    },
    "node_modules/@shiye/workspace": {
      "resolved": "apps/workspace",
      "link": true
    },
    "packages/adapters/ai": {
      "name": "@shiye/ai-adapter",
      "version": "0.0.0"
    },
    "packages/application": {
      "name": "@shiye/application",
      "version": "0.0.0"
    },
    "packages/core": {
      "name": "@shiye/core",
      "version": "0.0.0"
    },
    "packages/storage": {
      "name": "@shiye/storage",
      "version": "0.0.0"
    }
  }
}
